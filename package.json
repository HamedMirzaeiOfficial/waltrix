{
  "name": "waltrix-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/typescript-sdk",
    "apps/web",
    "examples/typescript-integration"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w @waltrix/sdk && npm run build -w @waltrix/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "~10.14.0",
    "eslint-plugin-react-hooks": "~7.1.1",
    "globals": "~16.5.0",
    "prettier": "^3.4.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "~8.72.1",
    "vitest": "^3.2.4"
  }
}
