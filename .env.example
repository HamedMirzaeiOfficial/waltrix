# Copy to .env (never commit .env). Local development values only.
WALTRIX_ENVIRONMENT=development
WALTRIX_DATABASE_URL=postgresql://waltrix@127.0.0.1:4822/waltrix
# Browser origins allowed to call the API cross-origin with credentials (JSON list). Empty = same-origin only.
WALTRIX_CORS_ORIGINS=[]
WALTRIX_COOKIE_SECURE=false
WALTRIX_SESSION_COOKIE_PATH=/api
WALTRIX_RATE_LIMIT_PER_MINUTE=600
WALTRIX_LOGIN_RATE_LIMIT_PER_MINUTE=10
# Reverse proxies in front of the API whose X-Forwarded-For is trusted (0 = ignore the header).
WALTRIX_TRUSTED_PROXY_COUNT=0
# Serve the built dashboard from the API process (optional), e.g. apps/web/dist
WALTRIX_WEB_DIST=
WALTRIX_LOG_LEVEL=INFO
WALTRIX_LOG_JSON=true
# Docker Compose only
POSTGRES_PASSWORD=waltrix-local-only
